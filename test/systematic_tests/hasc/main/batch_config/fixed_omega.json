{
	"exp_type": "fixed_omega",
	"sequences": ["all"],
	"preprocessing": {
		"clustering": {
			"algorithm": "bkmeans",
			"parameters": {
				"n_clusters": {
					"HASC1001": 4,
					"HASC1002": 5,
					"HASC1003": 4,
					"HASC1004": 6,
					"HASC1005": 6,
					"HASC1006": 8,
					"HASC1007": 7,
					"HASC1008": 5,
					"HASC1009": 4,
					"HASC1010": 4,
					"HASC1011": 10,
					"HASC1012": 8,
					"HASC1013": 4,
					"HASC1014": 5,
					"HASC1015": 5,
					"HASC1016": 4,
					"HASC1017": 5,
					"HASC1018": 4
