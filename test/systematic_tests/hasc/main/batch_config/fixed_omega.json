			"eta": {
				"min": 0.01,
				"max": 0.1
			},
			"rho_eta_mapping": "avg_linear",
			"k": 5,
			"L": 15
		},
		"pearl_e": {
			"eta": {
				"min": 0.01,
				"max": 0.1
			},
			"rho_eta_mapping": "event_linear",
			"k": 5,
			"L": 15
		}
	},
	"visualization": {
		"plots": ["mae_omega"]
	}
